<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="mariadb-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <properties>
            <!--
                NOTE: Connection credentials (url, user, password, driver) are NOT
                defined here. They are loaded from db.properties and injected
                programmatically by JpaConfig.buildJpaProperties() at startup.
                Edit src/main/resources/db.properties to change connection settings.
            -->

            <!-- Hibernate Properties -->
            <property name="hibernate.dialect"        value="org.hibernate.dialect.MariaDBDialect"/>
            <property name="hibernate.hbm2ddl.auto"   value="update"/>
            <property name="hibernate.show_sql"        value="true"/>
            <property name="hibernate.format_sql"      value="true"/>

            <!-- Connection Pool Settings (Hibernate built-in pool) -->
            <property name="hibernate.connection.pool_size" value="20"/>
        </properties>
    </persistence-unit>
</persistence>
